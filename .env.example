# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada para redirects de OAuth y callbacks de MP)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago — app "Marketplace" (developers.mercadopago.com)
MP_APP_CLIENT_ID=
MP_APP_CLIENT_SECRET=
# Access token de la cuenta de ANC, usado solo para verificar pagos via API (no para cobrar)
MP_ANC_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Resend (resend.com) — envío de emails de confirmación con QR
RESEND_API_KEY=
RESEND_FROM_EMAIL="ANC Tickets <tickets@ancdigital.cl>"
