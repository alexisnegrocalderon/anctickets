# ANC Tickets — plantilla de variables para Vercel (Preview y Production)
#
# No subas este archivo convertido en .env.production con secretos al repositorio.
# En Vercel: Settings → Environment Variables → Paste .env, pega el bloque completo
# tras reemplazar cada marcador <...> por su valor real.

# Neon PostgreSQL
# Runtime pooled URL: Neon Dashboard → Connection Details → Pooled connection
DATABASE_URL=<NEON_POOLED_DATABASE_URL_CON_SSLMODE_REQUIRE>
# Migrations / administrative direct URL: Neon Dashboard → Connection Details → Direct connection
DATABASE_URL_UNPOOLED=<NEON_DIRECT_DATABASE_URL_CON_SSLMODE_REQUIRE>

# URLs públicas de producción
BETTER_AUTH_URL=https://tickets.ancdigital.cl
NEXT_PUBLIC_SITE_URL=https://tickets.ancdigital.cl

# Seguridad y operación ANC
# Genera una vez con: openssl rand -base64 32
# Mantén este valor estable después del lanzamiento.
BETTER_AUTH_SECRET=<GENERAR_SECRETO_ALEATORIO_PERSISTENTE>
# Correo del operador ANC que aprobará organizaciones.
# Debe estar definido antes del primer registro de esa cuenta.
ANC_ADMIN_EMAIL=<CORREO_REAL_DEL_ADMINISTRADOR_ANC>

# Google OAuth
# Callback autorizado requerido:
# https://tickets.ancdigital.cl/api/auth/callback/google
GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_OAUTH_CLIENT_SECRET>

# Resend
# Verifica el dominio/remitente antes de usar EMAIL_FROM.
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM=ANC Tickets <tickets@ancdigital.cl>

# Mercado Pago Marketplace
# Redirect URI requerido:
# https://tickets.ancdigital.cl/api/mercadopago/oauth/callback
# Webhook requerido:
# https://tickets.ancdigital.cl/api/webhooks/mercadopago
MP_APP_CLIENT_ID=<MERCADO_PAGO_MARKETPLACE_CLIENT_ID>
MP_APP_CLIENT_SECRET=<MERCADO_PAGO_MARKETPLACE_CLIENT_SECRET>
MP_ANC_ACCESS_TOKEN=<MERCADO_PAGO_ANC_ACCESS_TOKEN>
MP_WEBHOOK_SECRET=<MERCADO_PAGO_WEBHOOK_SECRET>
